{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adfcapstone1234"
		},
		"ls_adls_capstone_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'ls_adls_capstone'"
		},
		"ls_databricks_accessToken": {
			"type": "secureString",
			"metadata": "Secure string for 'accessToken' of 'ls_databricks'"
		},
		"ls_adls_capstone_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://capstoneadls1234.dfs.core.windows.net/"
		},
		"ls_keyvault_capstone_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://capstonekeyvault1234.vault.azure.net/"
		},
		"ls_sql_capstone_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "capstonedatabase.database.windows.net"
		},
		"ls_sql_capstone_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "capstonedb"
		},
		"ls_sql_capstone_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "sqladmin"
		},
		"ls_databricks_properties_typeProperties_existingClusterId": {
			"type": "string",
			"defaultValue": "0521-105036-fz5btwgy"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adfcapstone1234_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"ls_adls_capstone_accountKey": {
						"value": "[parameters('ls_adls_capstone_accountKey')]"
					},
					"ls_databricks_accessToken": {
						"value": "[parameters('ls_databricks_accessToken')]"
					},
					"ls_adls_capstone_properties_typeProperties_url": {
						"value": "[parameters('ls_adls_capstone_properties_typeProperties_url')]"
					},
					"ls_keyvault_capstone_properties_typeProperties_baseUrl": {
						"value": "[parameters('ls_keyvault_capstone_properties_typeProperties_baseUrl')]"
					},
					"ls_databricks_properties_typeProperties_existingClusterId": {
						"value": "[parameters('ls_databricks_properties_typeProperties_existingClusterId')]"
					},
					"ls_sql_capstone_properties_typeProperties_server": {
						"value": "[parameters('ls_sql_capstone_properties_typeProperties_server')]"
					},
					"ls_sql_capstone_properties_typeProperties_database": {
						"value": "[parameters('ls_sql_capstone_properties_typeProperties_database')]"
					},
					"ls_sql_capstone_properties_typeProperties_userName": {
						"value": "[parameters('ls_sql_capstone_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}